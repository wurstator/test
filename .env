# Scientific Literature Agent - Configuration
# This file contains your actual secrets - DO NOT commit to git

# LLM Configuration
LLM_MODEL=mistral/mistral-small-latest
LLM_TEMPERATURE=0.7
LITELLM_VERBOSE=false

# Search Configuration
MAX_RESULTS=20

# API Configuration (REQUIRED)
# IMPORTANT: Set your email for NCBI Entrez API
ENTREZ_EMAIL=researcher@scientific-literature-agent.local

# Output Configuration
SAVE_RESULTS=false
OUTPUT_DIR=./output

# Debug Settings
VERBOSE=false

# ============================================================
# LLM API Keys
# ============================================================

# Mistral AI
MISTRAL_API_KEY=Vx8nlXfY8v5Hp7GZZi7vFRkGfHva40Xz

# OpenAI (if needed)
# OPENAI_API_KEY=sk-...

# Anthropic (Claude) (if needed)
# ANTHROPIC_API_KEY=sk-ant-...

# Cohere (if needed)
# COHERE_API_KEY=...

# ============================================================
# Local LLM Configuration
# ============================================================
# If using Ollama or other local LLMs, no API key needed
# Just set the model name:
# LLM_MODEL=ollama/llama2
# LLM_MODEL=ollama/mistral
