# Scientific Literature Agent - Default Configuration
# Copy this file to .env and customize with your actual values

# LLM Configuration
LLM_MODEL=mistral/mistral-small-latest
LLM_TEMPERATURE=0.7
LITELLM_VERBOSE=false

# Search Configuration
MAX_RESULTS=20

# API Configuration (REQUIRED)
# IMPORTANT: Set your email for NCBI Entrez API
ENTREZ_EMAIL=your.email@example.com

# Output Configuration
SAVE_RESULTS=false
OUTPUT_DIR=./output

# Debug Settings
VERBOSE=false

# ============================================================
# Optional: LLM API Keys
# ============================================================
# Uncomment and set the API key for your chosen LLM provider

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Mistral AI
# MISTRAL_API_KEY=...

# Cohere
# COHERE_API_KEY=...

# ============================================================
# Local LLM Configuration
# ============================================================
# If using Ollama or other local LLMs, no API key needed
# Just set the model name:
# LLM_MODEL=ollama/llama2
# LLM_MODEL=ollama/mistral
